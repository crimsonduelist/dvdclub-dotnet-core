@using DvdClub.Domain.Entities
@using DvdClub.Domain.Enumeration
@using DvdClub.Web.Areas.Movies.Models

@model DvdClub.Application.Models.PaginationModel<MovieIndexViewModel>

@if (Model.TotalPagesCount > 1) {
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (Model.PageNum > 1) {
                <li class="page-item"><a class="page-link" href="#" data-page="@(Model.PageNum - 1)">Previous</a></li>
            }
            @foreach (var p in Model.Pages) {
                <li class="page-item @(p == Model.PageNum ? "active" : "")">
                    <a class="page-link" href="#" data-page="@p">@p</a>
                </li>
            }
            @if (Model.PageNum < Model.TotalPagesCount) {
                <li class="page-item"><a class="page-link" href="#" data-page="@(Model.PageNum + 1)">Next</a></li>
            }
        </ul>
    </nav>
}

<table class="table">
    <tr>
        <th>Id</th>
        <th>Title</th>
        <th>Genre</th>
        <th>Description</th>
        <th>Available Copies</th>
        <th></th>
    </tr>

    @foreach (var item in Model.Items) {
        <tr>
            <td>@item.Id</td>
            <td>@item.Title</td>
            <td>@item.Genre</td>
            <td>@item.Description</td>
            <td>@item.Copy.Count(x => x.Availability != false)</td>
            <td>
                @if (User.IsInRole("Admin")) {
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) @: |
                }
                @if (User.Identity.IsAuthenticated) {
                    @Html.ActionLink("Rent", "Create", "Rentals", new { Area = "Rentals", movieId = item.Id }, new { })
                }
            </td>
        </tr>
    }
</table>

@if (Model.TotalPagesCount > 1) {
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (Model.PageNum > 1) {
                <li class="page-item"><a class="page-link" href="#" data-page="@(Model.PageNum - 1)">Previous</a></li>
            }
            @foreach (var p in Model.Pages) {
                <li class="page-item @(p == Model.PageNum ? "active" : "")">
                    <a class="page-link" href="#" data-page="@p">@p</a>
                </li>
            }
            @if (Model.PageNum < Model.TotalPagesCount) {
                <li class="page-item"><a class="page-link" href="#" data-page="@(Model.PageNum + 1)">Next</a></li>
            }
        </ul>
    </nav>
}

<p>Page @(Model.TotalPagesCount < Model.PageNum ? 0 : Model.PageNum) of @Model.TotalPagesCount</p>
