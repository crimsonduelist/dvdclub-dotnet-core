@using DvdClub.Domain.Entities
@using DvdClub.Domain.Enumeration
@using DvdClub.Web.Areas.Movies.Models

@model DvdClub.Application.Models.PaginationModel<MovieIndexViewModel>
@{
    ViewBag.Title = "Movies";
}

<h2>Movies</h2>

@if (User.IsInRole("Admin")) {
    <p>
        @Html.ActionLink("Add A Movie", "Create")
    </p>
}

@using (Html.BeginForm("Index", "Movies", FormMethod.Get, new {
    data_ajax = "true",
    data_ajax_mode = "replace",
    data_ajax_update = "#moviesContainer"
})) {
    <div class="d-flex align-items-center gap-1">
        @Html.TextBox("searchString", Model.SearchString, new { @class = "form-control", style = "max-width:200px", id = "searchInput" })
        @Html.DropDownList("genre",
            Html.GetEnumSelectList<DvdClub.Domain.Enumeration.Genre>(),
            "Genre", new { @class = "form-control", style = "max-width:160px", id = "genreSelect" })
        <input type="submit" class="btn btn-primary" value="Search" />
    </div>
}

<div id="moviesContainer">
    @await Html.PartialAsync("_MoviesTable", Model)
</div>

@section Scripts {
<script>
    (function() {
        var timer;
        document.getElementById('searchInput').addEventListener('input', function() {
            clearTimeout(timer);
            timer = setTimeout(function() { $('form[data-ajax]').submit(); }, 400);
        });
        document.getElementById('genreSelect').addEventListener('change', function() {
            $('form[data-ajax]').submit();
        });
        $(document).on('click', '#moviesContainer a[data-page]', function(e) {
            e.preventDefault();
            var page = $(this).data('page');
            var form = $('form[data-ajax]');
            var url = form.attr('action') + '?page=' + page + '&' + form.serialize();
            $.get(url, function(data) {
                $('#moviesContainer').html(data);
            });
        });
    })();
</script>
}
