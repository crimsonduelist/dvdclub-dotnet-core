@model DvdClub.Web.Areas.Customers.Models.CustomersIndexViewModel

@{
    ViewBag.Title = "Customers";
}

<h2>Customers</h2>

@if (User.IsInRole("Admin")) {
    <p>
        <a asp-action="Create">Add New Customer</a>
    </p>
}

<table class="table">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Membership</th>
        <th></th>
    </tr>
    @foreach (var item in Model.Customers) {
        <tr>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.Phone</td>
            <td>@item.MembershipType</td>
            <td>
                @Html.ActionLink("Details", "Details", new { id = item.Id })
                @if (User.IsInRole("Admin")) {
                    @: | @Html.ActionLink("Edit", "Edit", new { id = item.Id })
                }
            </td>
        </tr>
    }
</table>
