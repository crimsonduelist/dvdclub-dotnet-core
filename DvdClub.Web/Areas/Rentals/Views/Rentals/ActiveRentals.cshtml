@model DvdClub.Web.Areas.Rentals.Models.RentalsViewModel

@{
    ViewBag.Title = "ActiveRentals";
}

<h2>Active Rentals</h2>

<table class="table">
    <tr>
        <th>Id</th>
        <th>Movie Title</th>
        <th>Customer</th>
        <th>Date Rented</th>
        <th>Expected Return</th>
        <th>State</th>
        <th>Comments</th>
        <th></th>
    </tr>

    @foreach (var item in Model.Rentals) {
        <tr>
            <td>@item.Id</td>
            <td>@item.Copy.Movie.Title</td>
            <td>@(item.Customer?.Name ?? "-")</td>
            <td>@item.DateRented.ToShortDateString()</td>
            <td>@item.ExpectedReturnDate.ToShortDateString()</td>
            <td>@item.State</td>
            <td>@item.Comments</td>
            <td>
                <button type="button" class="btn btn-sm btn-success return" data-rentid=@item.Id>
                    Return
                </button>
            </td>
        </tr>
    }
</table>

@section Scripts {
    <script>
        $(".return").on("click", function (e) {
            var button = $(e.target);
            var id = button.attr('data-rentid');
            $.ajax({
                type: 'POST',
                url: '/Rentals/Rentals/Return',
                data: { id: id },
                success: function (data) {
                    alert(data.message);
                    button.parents('tr').fadeOut(1000);
                },
                error: function () {
                    alert("Error returning rental.");
                }
            });
            return false;
        });
    </script>
}
