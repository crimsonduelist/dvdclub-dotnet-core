@model DvdClub.Web.Areas.Members.Models.MembersIndexViewModel

@{
    ViewBag.Title = "Members";
}

<h2>Members</h2>

<table class="table">
    <tr>
        <th>Username</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Email</th>
    </tr>
    @foreach (var item in Model.Users) {
        <tr>
            <td>@item.UserName</td>
            <td>@item.FirstName</td>
            <td>@item.LastName</td>
            <td>@item.Email</td>
        </tr>
    }
</table>
